{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rescreen-contract/1.0/qa_replay.schema.json",
  "title": "qa_replay",
  "type": "object",
  "required": [
    "contract_version",
    "replays"
  ],
  "properties": {
    "replays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "proposal",
          "baseline_version",
          "proposal_version",
          "changed_parameters",
          "baseline_metrics",
          "proposal_metrics",
          "lost_true_links",
          "policy_outcome",
          "reviewer_action"
        ],
        "properties": {
          "lost_true_links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pair",
                "stage",
                "detail"
              ],
              "properties": {
                "stage": {
                  "enum": [
                    "retrieval",
                    "scoring"
                  ]
                }
              }
            }
          },
          "policy_outcome": {
            "enum": [
              "HELD_FOR_REVIEW",
              "ELIGIBLE_FOR_APPROVAL"
            ]
          }
        }
      }
    }
  }
}