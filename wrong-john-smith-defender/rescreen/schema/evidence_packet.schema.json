{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rescreen-contract/1.0/evidence_packet.schema.json",
  "title": "evidence_packet",
  "type": "object",
  "required": [
    "contract_version",
    "case_id",
    "customer_id",
    "booking_entity",
    "source_snapshot_ids",
    "candidate_edges",
    "evidence_items",
    "identified_conflicts",
    "missing_fields"
  ],
  "properties": {
    "source_snapshot_ids": {
      "type": "object",
      "required": [
        "list",
        "kyc"
      ],
      "properties": {}
    },
    "candidate_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "retrieval",
          "name_only",
          "splink",
          "guard",
          "raise_alert",
          "evidence_classification"
        ],
        "properties": {
          "retrieval": {
            "type": "object",
            "required": [
              "blocking_rules"
            ],
            "properties": {
              "blocking_rules": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "name_only": {
            "type": "object",
            "required": [
              "score",
              "decision"
            ],
            "properties": {
              "score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "decision": {
                "enum": [
                  "LINK",
                  "REVIEW",
                  "NO_LINK"
                ]
              }
            }
          },
          "splink": {
            "type": "object",
            "required": [
              "match_probability",
              "match_weight",
              "decision",
              "field_contributions"
            ],
            "properties": {
              "match_probability": {
                "type": "number"
              },
              "match_weight": {
                "type": "number"
              },
              "decision": {
                "enum": [
                  "LINK",
                  "REVIEW",
                  "NO_LINK"
                ]
              },
              "field_contributions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "field",
                    "level_key",
                    "bayes_factor",
                    "match_weight"
                  ],
                  "properties": {}
                }
              }
            }
          },
          "guard": {
            "type": "object",
            "required": [
              "decision",
              "outcome",
              "reasons",
              "dob_check_status"
            ],
            "properties": {
              "decision": {
                "enum": [
                  "LINK",
                  "REVIEW",
                  "NO_LINK"
                ]
              },
              "outcome": {
                "type": "string"
              },
              "dob_check_status": {
                "enum": [
                  "contradiction",
                  "consistent",
                  "not_assessable"
                ]
              }
            }
          },
          "raise_alert": {
            "type": "boolean"
          },
          "evidence_classification": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "dimension",
                "classification",
                "evidence_ids"
              ],
              "properties": {
                "dimension": {
                  "type": "string"
                },
                "classification": {
                  "enum": [
                    "supporting",
                    "conflicting",
                    "missing",
                    "neutral"
                  ]
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^EV-[0-9a-f]{12}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "subject_type",
          "subject_id",
          "field",
          "observed_value",
          "precision",
          "status",
          "verification",
          "source_id",
          "source_snapshot_id"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EV-[0-9a-f]{12}$"
          },
          "subject_type": {
            "enum": [
              "customer",
              "list_entry"
            ]
          },
          "subject_id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "precision": {
            "enum": [
              "full",
              "year_month",
              "year",
              "unknown",
              "unparseable",
              "exact"
            ]
          },
          "status": {
            "enum": [
              "known",
              "unknown",
              "placeholder"
            ]
          },
          "verification": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "unverified",
                  "unknown",
                  "documented"
                ]
              }
            }
          },
          "source_id": {
            "type": "string"
          },
          "source_snapshot_id": {
            "type": "string"
          }
        }
      }
    },
    "identified_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "classification",
          "evidence_ids"
        ],
        "properties": {
          "dimension": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "supporting",
              "conflicting",
              "missing",
              "neutral"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EV-[0-9a-f]{12}$"
            }
          }
        }
      }
    }
  }
}