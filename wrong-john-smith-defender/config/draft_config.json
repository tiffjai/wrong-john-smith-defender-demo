{
  "_comment": "Scoring parameters. Edit ONLY before running scripts/freeze_config.py. After freezing, the pipeline and the evaluation read config/frozen_config.json and refuse to run if its hash does not match. All values are builder-chosen illustrative parameters, NOT fitted to labelled data.",
  "name_only": {
    "scorer": "rapidfuzz.fuzz.token_sort_ratio",
    "link_threshold": 90.0,
    "review_threshold": 75.0
  },
  "splink": {
    "link_threshold_probability": 0.80,
    "review_threshold_probability": 0.30,
    "probability_two_random_records_match": 0.01,
    "training": "none: fixed, documented m/u probabilities (see README: 5 synthetic records are far too few for EM)",
    "comparisons": {
      "name": {
        "column": "name_norm",
        "levels": [
          {"key": "exact",   "description": "Exact normalised name",                  "m": 0.78, "u": 0.002},
          {"key": "alias",   "description": "Documented alias (sourced alias table)", "m": 0.08, "u": 0.0002},
          {"key": "jw_092",  "description": "Jaro-Winkler >= 0.92",                    "m": 0.08, "u": 0.003},
          {"key": "jw_080",  "description": "Jaro-Winkler >= 0.80",                    "m": 0.04, "u": 0.02},
          {"key": "else",    "description": "All other comparisons",                   "m": 0.02, "u": 0.9748}
        ]
      },
      "dob": {
        "column": "dob_year/dob_month/dob_day",
        "levels": [
          {"key": "full_exact",    "description": "Full date exact match",                                   "m": 0.80, "u": 0.00005},
          {"key": "year_month",    "description": "Year+month agree (at least one date lacks a day)",        "m": 0.06, "u": 0.0008},
          {"key": "year_only",     "description": "Year agrees (at least one date lacks a month)",           "m": 0.04, "u": 0.012},
          {"key": "mismatch",      "description": "Differ at the precision both dates share",                "m": 0.10, "u": 0.98715}
        ]
      },
      "country": {
        "column": "country_norm",
        "levels": [
          {"key": "same", "description": "Same country", "m": 0.92, "u": 0.45},
          {"key": "else", "description": "Different country", "m": 0.08, "u": 0.55}
        ]
      },
      "city": {
        "column": "city_norm",
        "levels": [
          {"key": "same", "description": "Same city", "m": 0.75, "u": 0.08},
          {"key": "else", "description": "Different city", "m": 0.25, "u": 0.92}
        ]
      }
    },
    "blocking_rules": [
      {"key": "same_family_name", "sql": "l.case_id = r.case_id AND l.family_key = r.family_key"},
      {"key": "same_alias_group", "sql": "l.case_id = r.case_id AND l.alias_group IS NOT NULL AND l.alias_group = r.alias_group"}
    ]
  },
  "guard": {
    "rule": "A verified FULL-precision date of birth on both records that differs is a contradiction. Partial-precision, unverified or unknown dates are never contradictions.",
    "apply_to_decisions": ["LINK", "REVIEW"],
    "chain_check": true
  }
}
